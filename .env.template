# --- Logging ---
BITSNIFFER_LOG_LEVEL=info
BITSNIFFER_LOG_FORMAT=text
BITSNIFFER_LOG_SOURCE=false

# --- Metrics & Tracing ---
BITSNIFFER_METRICS_ENABLED=true
BITSNIFFER_METRICS_HOST=127.0.0.1
BITSNIFFER_METRICS_PORT=9080
BITSNIFFER_METRICS_PATH=/metrics
BITSNIFFER_TRACING_ENABLED=false
BITSNIFFER_SHUTDOWN_GRACE=30s
AWS_REGION=

# --- Libp2p host ---
BITSNIFFER_LIBP2P_HOST=127.0.0.1
BITSNIFFER_LIBP2P_PORT=9020
BITSNIFFER_CONNECTION_TIMEOUT=15s
BITSNIFFER_CONNECTIONS_LOW=1000
BITSNIFFER_CONNECTIONS_HIGH=8000

# --- Sniffer / batching ---
BITSNIFFER_CACHE_SIZE=0
BITSNIFFER_LEVEL_DB=./ds
BITSNIFFER_DISCOVERY_INTERVAL=1m
BITSNIFFER_BATCHER_SIZE=1024

# --- ClickHouse connection ---
BITSNIFFER_CLICKHOUSE_HOST=127.0.0.1
BITSNIFFER_CLICKHOUSE_PORT=9000
BITSNIFFER_CLICKHOUSE_USER=username
BITSNIFFER_CLICKHOUSE_PASSWORD=password
BITSNIFFER_CLICKHOUSE_SSL=false
BITSNIFFER_CLICKHOUSE_DATABASE=bitswap_sniffer_db

# --- ClickHouse migrations ---
BITSNIFFER_CLICKHOUSE_CLUSTER=
BITSNIFFER_CLICKHOUSE_MIGRATIONS_TABLE=schema_migrations
BITSNIFFER_CLICKHOUSE_MIGRATIONS_TABLE_ENGINE=TinyLog
BITSNIFFER_CLICKHOUSE_MIGRATIONS_MULTI_STATEMENT=false
BITSNIFFER_CLICKHOUSE_MIGRATIONS_MULTI_STATEMENT_MAX_SIZE=10485760
BITSNIFFER_CLICKHOUSE_MIGRATIONS_REPLICATED_TABLE_ENGINES=false
